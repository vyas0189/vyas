---
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/contact', label: 'Contact' },
];

// Static builds may render '/about/' for '/about'; compare without the slash.
const normalize = (path: string) => path.replace(/(.)\/$/, '$1');
const currentPath = normalize(Astro.url.pathname);
---

<header
	transition:persist
	class='sticky top-0 z-40 w-full border-b bg-background/95 backdrop-blur-sm supports-[backdrop-filter]:bg-background/60'>
	<div class='container flex h-16 items-center px-4'>
		<nav id='site-nav' class='flex flex-1 items-center space-x-6 text-sm font-medium'>
			{
				links.map((link) => (
					<a
						href={link.href}
						aria-current={currentPath === link.href ? 'page' : undefined}
						class:list={[
							'transition-all duration-200 hover:text-foreground hover:scale-105',
							currentPath === link.href
								? 'text-foreground font-semibold'
								: 'text-foreground/60',
						]}>
						{link.label}
					</a>
				))
			}
		</nav>
		<div class='flex items-center space-x-2'>
			<div class='theme-toggle-wrapper'>
				<button
					id='theme-toggle'
					class='inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 w-10'
					aria-label='Toggle theme'
					aria-haspopup='menu'
					aria-expanded='false'
					aria-controls='theme-menu'>
					<svg
						xmlns='http://www.w3.org/2000/svg'
						width='24'
						height='24'
						viewBox='0 0 24 24'
						fill='none'
						stroke='currentColor'
						stroke-width='2'
						stroke-linecap='round'
						stroke-linejoin='round'
						class='sun-icon h-[1.2rem] w-[1.2rem] rotate-0 scale-100 transition-all dark:-rotate-90 dark:scale-0'
						aria-hidden='true'>
						<circle cx='12' cy='12' r='4'></circle>
						<path d='M12 2v2'></path>
						<path d='M12 20v2'></path>
						<path d='m4.93 4.93 1.41 1.41'></path>
						<path d='m17.66 17.66 1.41 1.41'></path>
						<path d='M2 12h2'></path>
						<path d='M20 12h2'></path>
						<path d='m6.34 17.66-1.41 1.41'></path>
						<path d='m19.07 4.93-1.41 1.41'></path>
					</svg>
					<svg
						xmlns='http://www.w3.org/2000/svg'
						width='24'
						height='24'
						viewBox='0 0 24 24'
						fill='none'
						stroke='currentColor'
						stroke-width='2'
						stroke-linecap='round'
						stroke-linejoin='round'
						class='moon-icon absolute h-[1.2rem] w-[1.2rem] rotate-90 scale-0 transition-all dark:rotate-0 dark:scale-100'
						aria-hidden='true'>
						<path d='M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z'></path>
					</svg>
				</button>
				<div id='theme-menu' class='theme-dropdown' role='menu' aria-label='Theme'>
					<button type='button' data-theme='light' class='theme-option' role='menuitemradio' aria-checked='false' tabindex='-1'>Light</button>
					<button type='button' data-theme='dark' class='theme-option' role='menuitemradio' aria-checked='false' tabindex='-1'>Dark</button>
					<button type='button' data-theme='system' class='theme-option' role='menuitemradio' aria-checked='false' tabindex='-1'>System</button>
				</div>
			</div>
		</div>
	</div>
</header>

<style>
	.theme-toggle-wrapper {
		position: relative;
	}

	.theme-dropdown {
		position: absolute;
		top: calc(100% + 4px);
		right: 0;
		z-index: 9999;
		min-width: 8rem;
		overflow: hidden;
		border: 1px solid hsl(var(--border));
		background-color: hsl(var(--popover));
		color: hsl(var(--popover-foreground));
		box-shadow:
			0 10px 15px -3px rgb(0 0 0 / 0.1),
			0 4px 6px -4px rgb(0 0 0 / 0.1);
		display: none;
		opacity: 0;
		transform: scale(0.95);
		transition:
			opacity 150ms,
			transform 150ms;
		border-radius: 0.375rem;
		padding: 0.25rem;
	}

	.theme-dropdown.open {
		display: block;
		opacity: 1;
		transform: scale(1);
	}

	.theme-option {
		position: relative;
		display: flex;
		cursor: default;
		user-select: none;
		align-items: center;
		border-radius: 0.125rem;
		padding: 0.375rem 0.5rem;
		font-size: 0.875rem;
		outline: none;
		transition:
			background-color 150ms,
			color 150ms;
		width: 100%;
		text-align: left;
		background: transparent;
		border: none;
		color: inherit;
	}

	.theme-option:hover,
	.theme-option:focus {
		background-color: hsl(var(--accent));
		color: hsl(var(--accent-foreground));
	}
</style>

<script>
	type Theme = 'light' | 'dark' | 'system';

	const THEMES: readonly Theme[] = ['light', 'dark', 'system'];
	const ACTIVE = ['text-foreground', 'font-semibold'];
	const INACTIVE = ['text-foreground/60'];
	const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');

	// No stored choice means "follow the OS". Nothing is written until the
	// visitor picks a theme, so their OS setting keeps applying until then.
	const getStoredTheme = (): Theme => {
		try {
			const stored = localStorage.getItem('theme');
			if (stored && (THEMES as readonly string[]).includes(stored)) return stored as Theme;
		} catch {
			// storage blocked (private mode, sandboxed iframe)
		}
		return 'system';
	};

	const applyTheme = (theme: Theme) => {
		const isDark = theme === 'dark' || (theme === 'system' && darkQuery.matches);
		document.documentElement.classList.toggle('dark', isDark);
		for (const option of document.querySelectorAll<HTMLElement>('.theme-option')) {
			option.setAttribute('aria-checked', String(option.dataset.theme === theme));
		}
	};

	const setTheme = (theme: Theme) => {
		try {
			if (theme === 'system') localStorage.removeItem('theme');
			else localStorage.setItem('theme', theme);
		} catch {
			// storage blocked; the choice still applies for this page
		}
		applyTheme(theme);
	};

	// The header persists across view transitions, so its server-rendered
	// active link would otherwise stay on the first page visited.
	const updateActiveLink = () => {
		const path = location.pathname.replace(/(.)\/$/, '$1');
		for (const link of document.querySelectorAll<HTMLAnchorElement>('#site-nav a')) {
			const active = link.getAttribute('href') === path;
			if (active) link.setAttribute('aria-current', 'page');
			else link.removeAttribute('aria-current');
			link.classList.remove(...(active ? INACTIVE : ACTIVE));
			link.classList.add(...(active ? ACTIVE : INACTIVE));
		}
	};

	function bindThemeMenu(toggleButton: HTMLButtonElement, dropdown: HTMLElement) {
		const options = () => [...dropdown.querySelectorAll<HTMLButtonElement>('.theme-option')];
		let isOpen = false;

		const focusOption = (index: number) => {
			const items = options();
			items[(index + items.length) % items.length]?.focus();
		};

		const openDropdown = (focus: 'checked' | 'first' | 'last' = 'checked') => {
			dropdown.classList.add('open');
			isOpen = true;
			toggleButton.setAttribute('aria-expanded', 'true');
			const items = options();
			const checked = items.findIndex((o) => o.getAttribute('aria-checked') === 'true');
			focusOption(focus === 'last' ? -1 : focus === 'first' || checked < 0 ? 0 : checked);
		};

		const closeDropdown = (refocus = false) => {
			dropdown.classList.remove('open');
			isOpen = false;
			toggleButton.setAttribute('aria-expanded', 'false');
			if (refocus) toggleButton.focus();
		};

		toggleButton.addEventListener('click', (e) => {
			e.stopPropagation();
			if (isOpen) closeDropdown();
			else openDropdown();
		});

		toggleButton.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
				e.preventDefault();
				openDropdown(e.key === 'ArrowUp' ? 'last' : 'first');
			}
		});

		dropdown.addEventListener('keydown', (e) => {
			const items = options();
			const index = items.indexOf(document.activeElement as HTMLButtonElement);
			switch (e.key) {
				case 'ArrowDown':
					e.preventDefault();
					focusOption(index + 1);
					break;
				case 'ArrowUp':
					e.preventDefault();
					focusOption(index - 1);
					break;
				case 'Home':
					e.preventDefault();
					focusOption(0);
					break;
				case 'End':
					e.preventDefault();
					focusOption(-1);
					break;
				case 'Escape':
					e.preventDefault();
					closeDropdown(true);
					break;
				case 'Tab':
					closeDropdown();
					break;
			}
		});

		// Close when clicking outside
		document.addEventListener('click', (e) => {
			if (isOpen && !dropdown.contains(e.target as Node) && !toggleButton.contains(e.target as Node)) {
				closeDropdown();
			}
		});

		for (const option of options()) {
			option.addEventListener('click', () => {
				const theme = option.dataset.theme as Theme | undefined;
				if (theme && THEMES.includes(theme)) {
					setTheme(theme);
					closeDropdown(true);
				}
			});
		}

		// Follow OS changes while on "System"
		darkQuery.addEventListener('change', () => {
			if (getStoredTheme() === 'system') applyTheme('system');
		});
	}

	function init() {
		applyTheme(getStoredTheme());
		updateActiveLink();

		const toggleButton = document.getElementById('theme-toggle') as HTMLButtonElement | null;
		const dropdown = document.getElementById('theme-menu');
		if (!toggleButton || !dropdown) return;

		// Guard against double-binding when the header persists across transitions
		if (toggleButton.dataset.bound === 'true') return;
		toggleButton.dataset.bound = 'true';
		bindThemeMenu(toggleButton, dropdown);
	}

	document.addEventListener('astro:page-load', init);
</script>
